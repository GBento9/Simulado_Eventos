{
  "name": "eventos-palestrantes",
  "version": "1.0.0",
  "description": "Gerenciamento de eventos e palestrantes com Node.js, Express e Prisma",
  "main": "src/server.js",
  "scripts": {
    "postinstall": "prisma generate",
    "setup": "prisma db push --force-reset && node prisma/seed.js",
    "seed": "node prisma/seed.js",
    "start": "node src/server.js",
    "dev": "node --watch src/server.js"
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "prisma": "6.19.0"
  },
  "engines": {
    "node": ">=18"
  }
}
