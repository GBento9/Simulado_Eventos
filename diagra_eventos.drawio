="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#F5F5F5;strokeColor=#999999;fontSize=12;arcSize=6;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="1200" height="100" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>